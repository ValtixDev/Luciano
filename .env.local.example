# Copie para .env.local e preencha com os dados do projeto Supabase.
# Painel → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Nunca commitar. A service role ignora RLS e só deve existir no servidor.
# SUPABASE_SERVICE_ROLE_KEY=

# Domínio público. Sem isto, canonical, Open Graph e sitemap apontam para o
# domínio de fallback e o compartilhamento em WhatsApp quebra.
NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app
